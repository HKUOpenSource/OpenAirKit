[Unit]
Description=Agentic-OCUDU isolated OAI core
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
PartOf=aoc-stack.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -I @RELEASE@/scripts/radio_runtime.py core-check
ExecStop=/usr/bin/python3 -I @RELEASE@/scripts/radio_runtime.py core-stop
UMask=0077
TimeoutStartSec=240
TimeoutStopSec=120
