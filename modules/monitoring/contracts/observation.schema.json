{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-ocudu:observation:1",
  "title": "Agentic-OCUDU observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "observed_at", "status", "reason", "metrics"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"enum": ["host", "ocudu", "oai_core", "user_plane"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ok", "stale", "unavailable", "unsupported"]},
    "reason": {"type": ["string", "null"]},
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "kind", "entity"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": ["number", "null"]},
          "unit": {"enum": ["bit/s", "byte", "count", "ms", "ratio", "dB", "index"]},
          "kind": {"enum": ["gauge", "counter", "window_count"]},
          "entity": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["unavailable", "unsupported"]}}},
      "then": {"properties": {"metrics": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["stale", "unavailable", "unsupported"]}}},
      "then": {"properties": {"reason": {"type": "string", "minLength": 1}}}
    }
  ]
}
