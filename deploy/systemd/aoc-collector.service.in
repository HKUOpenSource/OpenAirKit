[Unit]
Description=Agentic-OCUDU telemetry collector
After=aoc-core.service
PartOf=aoc-stack.target

[Service]
Type=simple
User=aoc-collector
Group=aoc-monitor
ExecStart=@PYTHON@ -m aoc_monitor.collector --config @CONFIG@/monitoring.json
Restart=on-failure
RestartSec=5
RuntimeDirectory=agentic-ocudu
RuntimeDirectoryMode=0750
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
