{
  "schema_version": 1,
  "owner": "agentic-ocudu-v2",
  "resources": {
    "spark_services": {"user": "agentic-ocudu", "config": "/etc/agentic-ocudu", "state": "/var/lib/agentic-ocudu", "logs": "/var/log/agentic-ocudu"},
    "core_network": {"project": "aoc-v2-open5gs", "bridge": "aoc-v2-core", "candidate_cidr": "172.28.80.0/24", "ue_pool": "10.0.0.0/24"},
    "monitor": {"listen": "127.0.0.1:8877", "owner": "agentic-ocudu-monitor"},
    "jetson": {"root": "/opt/agentic-ocudu/jetson", "state": "/var/lib/agentic-ocudu/jetson", "listen": "127.0.0.1:8878"},
    "radio": {"device": "B210", "lock": "/run/lock/agentic-ocudu-b210.lock", "serial_policy": "exclusive"},
    "ue": {"state": "/var/lib/agentic-ocudu/ue", "serial_policy": "exclusive"}
  },
  "never_own": ["external services", "external databases", "shared UHD installation", "tailscale0", "Wi-Fi management route"],
  "release_order": ["stop owned applications", "stop owned containers", "remove owned routes", "remove owned bridge", "release device lock"],
  "preflight": ["check listener and CIDR conflicts", "check route ownership", "check B210 holder", "check serial holder", "check management route"],
  "observed_conflicts": [{"resource": "172.28.80.0/24", "state": "old stopped aoc-cn5g bridge/IPAM reservation", "action": "resolve ownership and clean only during V2 deployment"}]
}
