[Unit]
Description=Agentic-OCUDU radio
Requires=aoc-v2-core.service
BindsTo=aoc-v2-core.service
After=aoc-v2-core.service

[Service]
Type=simple
Environment=HOME=/root
ExecStartPre=/usr/bin/python3 -I /opt/agentic-ocudu/v2/runtime.py prepare
ExecStart=/opt/agentic-ocudu/v2/bin/gnb -c /var/lib/agentic-ocudu/v2/gnb.json
ExecStartPost=/usr/bin/python3 -I /opt/agentic-ocudu/v2/runtime.py radio-health
TimeoutStartSec=240
TimeoutStopSec=45
KillSignal=SIGINT
KillMode=control-group
Restart=no
LimitRTPRIO=99
LimitMEMLOCK=infinity
UMask=0077
StandardOutput=journal
StandardError=journal
