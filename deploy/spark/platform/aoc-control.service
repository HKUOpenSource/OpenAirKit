[Unit]
Description=Agentic-OCUDU restricted V2 stack control executor
After=docker.service

[Service]
User=root
Group=aoc-control
WorkingDirectory=@RELEASE@/backend
ExecStart=@RELEASE@/venv/bin/python -m aoc_spark.control
RuntimeDirectory=aoc-control
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
ReadWritePaths=/var/lib/agentic-ocudu/v2 /var/log/agentic-ocudu/v2 /run/lock
InaccessiblePaths=-/opt/oai-console -/etc/oai-console -/var/lib/oai-console

[Install]
WantedBy=multi-user.target
